{
  "name": "@onelitefeathernet/pavo",
  "version": "0.1.0",
  "description": "OneLiteFeather Material 3 library for Nuxt 4 and Vue 3, styled with Tailwind CSS v4",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneLiteFeatherNET/pavo.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "packageManager": "pnpm@10.33.4",
  "files": [
    "dist",
    "bin"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./vue": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./problem": {
      "types": "./dist/runtime/lib/problem.d.ts",
      "import": "./dist/runtime/lib/problem.js"
    },
    "./css": "./dist/runtime/css/index.css",
    "./css/theme": "./dist/runtime/css/theme.css",
    "./css/tokens": "./dist/runtime/css/tokens.css",
    "./tokens": {
      "types": "./dist/runtime/tokens/generate.d.ts",
      "import": "./dist/runtime/tokens/generate.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "bin": {
    "pavo-tokens": "bin/pavo-tokens.mjs"
  },
  "scripts": {
    "dev": "nuxi dev playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "prepack": "nuxt-module-build build",
    "check:dist": "node scripts/check-dist.mjs",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit && nuxi typecheck playground",
    "test": "vitest run --maxWorkers=2",
    "tokens": "node scripts/tokens.ts"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@material/material-color-utilities": "^0.3.0",
    "@mdi/js": "^7.4.47",
    "@nuxt/kit": "^4.7.0",
    "@nuxt/schema": "^4.7.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.4",
    "@nuxtjs/i18n": "^10.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "nuxt": "^4.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.14"
  }
}
